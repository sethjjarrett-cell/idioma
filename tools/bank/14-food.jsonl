{"id":"verdura","es":"verdura","en":["vegetables","vegetable"],"pos":"noun","topic":"food","note":"f. Usually plural: las verduras.","sent":{"es":"Hay que comer más {verduras}.","en":"You have to eat more vegetables."}}
{"id":"ensalada","es":"ensalada","en":["salad"],"pos":"noun","topic":"food","note":"f.","sent":{"es":"Una {ensalada} sin cebolla, por favor.","en":"A salad without onion, please."}}
