{"id":"cuchillo","es":"cuchillo","en":["knife"],"pos":"noun","topic":"food","note":"m.","sent":{"es":"Este {cuchillo} no corta.","en":"This knife does not cut."}}
{"id":"cuchara","es":"cuchara","en":["spoon"],"pos":"noun","topic":"food","note":"f. cucharita is a teaspoon.","sent":{"es":"Necesito una {cuchara} para la sopa.","en":"I need a spoon for the soup."}}
{"id":"taza","es":"taza","en":["cup","mug"],"pos":"noun","topic":"food","note":"f. una taza de café.","sent":{"es":"Una {taza} de chocolate, por favor.","en":"A cup of hot chocolate, please."}}
{"id":"botella","es":"botella","en":["bottle"],"pos":"noun","topic":"food","note":"f.","sent":{"es":"Una {botella} de agua, por favor.","en":"A bottle of water, please."}}
